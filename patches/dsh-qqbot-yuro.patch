diff --git a/dist/group-tools.js b/dist/group-tools.js
new file mode 100644
index 0000000000000000000000000000000000000000..9040b8f447faf9c0495ae740130e71fa37c0a206
--- /dev/null
+++ b/dist/group-tools.js
@@ -0,0 +1,299 @@
+// [local-patch 2026-08-20 P2-11] 群聊生图/表情包/发图工具注册
+// 由 bootstrap.js 在 apply 时调用: registerGroupTools(ctx, sender)
+// 依赖: ctx.tools (harness tools 服务), sender (含 sendImage)
+import { readFileSync, existsSync, writeFileSync, mkdirSync, readdirSync, copyFileSync } from 'node:fs';
+import { join, dirname } from 'node:path';
+import { randomUUID } from 'node:crypto';
+import { spawn } from 'node:child_process'; // [local-patch 2026-08-20 P2-12] ComfyUI 懒启动
+
+const COMFYUI_BASE = 'http://127.0.0.1:5000';
+const COMFYUI_WF = '<COMFYUI_HOME>/test_workflow.json';
+const COMFYUI_OUT = '<COMFYUI_HOME>/ComfyUI/output';
+const STICKER_DIR = 'C:/Users/<USER>/.dsh/<WORK_DIR>/stickers';
+
+// [local-patch 2026-08-20 P2-12] ComfyUI 懒启动: 调用时检测, 未启动则拉起
+const COMFYUI_HOME = '<COMFYUI_HOME>';
+const COMFYUI_PYTHON = COMFYUI_HOME + '/python_embeded/python.exe';
+const COMFYUI_LOG = 'C:/Users/<USER>/.dsh/<WORK_DIR>/comfyui.log';
+let _comfyStarting = false;
+let _comfyStartPromise = null;
+
+async function comfyAlive() {
+    try {
+        const ctrl = new AbortController();
+        const t = setTimeout(() => ctrl.abort(), 3000);
+        try {
+            const resp = await fetch(COMFYUI_BASE + '/system_stats', { signal: ctrl.signal });
+            return resp.ok;
+        } finally { clearTimeout(t); }
+    } catch { return false; }
+}
+
+async function startComfyUI() {
+    if (await comfyAlive()) return;
+    if (_comfyStarting) return _comfyStartPromise;
+    _comfyStarting = true;
+    _comfyStartPromise = (async () => {
+        const { mkdirSync } = await import('node:fs');
+        const { dirname } = await import('node:path');
+        mkdirSync(dirname(COMFYUI_LOG), { recursive: true });
+        const logFd = await import('node:fs').then(fs => fs.openSync(COMFYUI_LOG, 'a'));
+        const child = spawn(COMFYUI_PYTHON, ['-s', 'ComfyUI/main.py', '--windows-standalone-build', '--port', '5000', '--disable-auto-launch'], {
+            cwd: COMFYUI_HOME,
+            detached: true,
+            stdio: ['ignore', logFd, logFd],
+        });
+        child.unref();
+        // 等就绪: 首次启动需编译 CUDA 内核 60-120s
+        for (let i = 0; i < 90; i++) {
+            await new Promise(r => setTimeout(r, 2000));
+            if (await comfyAlive()) { _comfyStarting = false; return; }
+        }
+        _comfyStarting = false;
+        throw new Error('ComfyUI 启动超时(180s), 见日志: ' + COMFYUI_LOG);
+    })();
+    return _comfyStartPromise;
+}
+
+/** 确保 ComfyUI 已启动(未启动则拉起并等待就绪) */
+async function ensureComfyUI() {
+    if (await comfyAlive()) return;
+    await startComfyUI();
+}
+
+async function comfyPost(path, data, timeoutMs = 120000) {
+    const ctrl = new AbortController();
+    const timer = setTimeout(() => ctrl.abort(), timeoutMs);
+    try {
+        const resp = await fetch(COMFYUI_BASE + path, {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify(data),
+            signal: ctrl.signal,
+        });
+        if (!resp.ok) throw new Error(`ComfyUI HTTP ${resp.status}`);
+        return await resp.json();
+    } finally { clearTimeout(timer); }
+}
+
+async function comfyGet(path, timeoutMs = 60000) {
+    const ctrl = new AbortController();
+    const timer = setTimeout(() => ctrl.abort(), timeoutMs);
+    try {
+        const resp = await fetch(COMFYUI_BASE + path, { signal: ctrl.signal });
+        if (!resp.ok) throw new Error(`ComfyUI HTTP ${resp.status}`);
+        return await resp.json();
+    } finally { clearTimeout(timer); }
+}
+
+/** 用 ComfyUI API 生图: 确保启动 → 改 workflow → 提交 → 轮询 → 返回图片绝对路径 */
+async function generateImage({ prompt, negative_prompt, width, height, steps, seed, filename_prefix, model }) {
+    await ensureComfyUI(); // [local-patch 2026-08-20 P2-12] 未启动则自动拉起
+    if (!existsSync(COMFYUI_WF)) throw new Error('workflow 文件不存在: ' + COMFYUI_WF);
+    const wf = JSON.parse(readFileSync(COMFYUI_WF, 'utf-8'));
+    const p = wf.prompt;
+    // 找 CLIPTextEncode 节点: 第一个是正向, 第二个是负向
+    const encodeNodes = Object.entries(p).filter(([, n]) => n.class_type === 'CLIPTextEncode');
+    if (encodeNodes.length < 2) throw new Error('workflow 缺少 CLIPTextEncode 节点');
+    const [posId, posNode] = encodeNodes[0];
+    const [negId, negNode] = encodeNodes[1];
+    posNode.inputs.text = prompt || posNode.inputs.text;
+    if (negative_prompt) negNode.inputs.text = negative_prompt;
+    // 尺寸节点
+    const emptyNodes = Object.entries(p).filter(([, n]) => n.class_type === 'EmptyLatentImage');
+    if (emptyNodes.length > 0) {
+        emptyNodes[0][1].inputs.width = width || 1024;
+        emptyNodes[0][1].inputs.height = height || 1024;
+    }
+    // KSampler: steps/seed
+    const ksNodes = Object.entries(p).filter(([, n]) => n.class_type === 'KSampler');
+    if (ksNodes.length > 0) {
+        if (steps) ksNodes[0][1].inputs.steps = steps;
+        if (seed !== undefined && seed !== null) ksNodes[0][1].inputs.seed = seed;
+    }
+    // 输出前缀
+    const saveNodes = Object.entries(p).filter(([, n]) => n.class_type === 'SaveImage');
+    const prefix = filename_prefix || 'qq_' + Date.now().toString(36);
+    if (saveNodes.length > 0) saveNodes[0][1].inputs.filename_prefix = prefix;
+    // 提交
+    const res = await comfyPost('/prompt', wf);
+    const pid = res?.prompt_id;
+    if (!pid) throw new Error('ComfyUI 提交失败: ' + JSON.stringify(res).slice(0, 300));
+    // 轮询
+    for (let i = 0; i < 120; i++) {
+        await new Promise(r => setTimeout(r, 2000));
+        try {
+            const hist = await comfyGet('/history/' + pid, 30000);
+            const entry = hist[pid];
+            if (!entry) continue;
+            const statusStr = entry.status?.status_str;
+            if (statusStr === 'success' || entry.status?.completed) {
+                for (const [, out] of Object.entries(entry.outputs || {})) {
+                    for (const img of out.images || []) {
+                        const p2 = join(COMFYUI_OUT, img.subfolder || '', img.filename);
+                        if (existsSync(p2)) return { image_path: p2, filename: img.filename };
+                    }
+                }
+                throw new Error('出图成功但找不到文件');
+            }
+            if (statusStr === 'error') throw new Error('ComfyUI 生成错误: ' + JSON.stringify(entry).slice(0, 400));
+        } catch (e) {
+            if (e.message?.includes('HTTP')) continue; // 轮询瞬时错误重试
+            throw e;
+        }
+    }
+    throw new Error('生图超时(240s)');
+}
+
+/** 从 stickers 目录选一个表情包(按情绪关键词匹配文件名) */
+function pickSticker(emotion) {
+    if (!existsSync(STICKER_DIR)) return undefined;
+    const files = readdirSync(STICKER_DIR).filter(f => /\.(png|jpe?g|gif|webp)$/i.test(f));
+    if (files.length === 0) return undefined;
+    // 情绪关键词 → 文件名子串匹配
